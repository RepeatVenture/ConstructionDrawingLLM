# Environment variables for BlueprintBid Local LLM Server
# Copy this to .env and edit as needed.

# ── Model ──────────────────────────────────────────────────────────────
MODEL_BACKEND=qwen2-vl          # qwen2-vl | llava | internvl2
QUANTIZATION=int4                # none | int8 | int4 | gptq | awq
MODEL_CACHE_DIR=./model_cache

# Override default HuggingFace model IDs (optional):
# QWEN2_VL_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct
# LLAVA_MODEL_ID=llava-hf/llava-v1.6-mistral-7b-hf

# ── Server ─────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=1

# ── Authentication ─────────────────────────────────────────────────────
REQUIRE_AUTH=false
BLUEPRINTBID_API_KEY=

# ── Inference ──────────────────────────────────────────────────────────
MAX_NEW_TOKENS=4096
TEMPERATURE=0.1
MAX_IMAGE_DIM=2048
ENABLE_OCR=true
MAX_CONCURRENT_REQUESTS=3

# ── Logging ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_IMAGES=false
