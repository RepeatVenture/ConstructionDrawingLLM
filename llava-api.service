[Unit]
Description=LLaVA Construction Drawing API Server
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/llava-api
Environment="PATH=/home/ubuntu/miniconda3/envs/llava/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="CUDA_VISIBLE_DEVICES=0"
ExecStart=/home/ubuntu/miniconda3/envs/llava/bin/python /home/ubuntu/llava-api/api_server.py
Restart=always
RestartSec=10
StandardOutput=append:/var/log/llava-api.log
StandardError=append:/var/log/llava-api-error.log

# Resource limits
LimitNOFILE=65536
TimeoutStartSec=600
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
